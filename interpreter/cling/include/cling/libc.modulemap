module "libc" [system] [extern_c] [no_undeclared_includes] {
  requires !windows

  export *
  module "assert.h" {
    export *
    textual header "assert.h"
  }
  module "string.h" {
    export *
    header "string.h"
  }
  module "strings.h" {
    export *
    header "strings.h"
  }
  module "ctype.h" {
    export *
    header "ctype.h"
  }
  module "errno.h" {
    export *
    header "errno.h"
  }
  module "fenv.h" {
    export *
    header "fenv.h"
  }
  module "inttypes.h" {
    export *
    header "inttypes.h"
  }
  module "math.h" {
    export *
    header "math.h"
  }
  module "pthread.h" {
    export *
    header "pthread.h"
  }
  module "setjmp.h" {
    export *
    header "setjmp.h"
  }
  module "signal.h" {
    export *
    header "signal.h"
  }
  module "stddef.h" {
    export *
    textual header "stddef.h"
  }
  module "stdio.h" {
    export *
    header "stdio.h"
  }
  module "stdlib.h" {
    export *
    header "stdlib.h"
  }
  module "time.h" {
    export *
    header "time.h"
  }
  module "wchar.h" {
    export *
    header "wchar.h"
  }
  module "stdint.h" {
    export *
    header "stdint.h"
  }
  module "stdarg.h" {
    export *
    textual header "stdarg.h"
  }
  module "unistd.h" {
    export *
    header "unistd.h"
  }
  module "fcntl.h" {
    export *
    header "fcntl.h"
  }
  module "dlfcn.h" {
    export *
    header "dlfcn.h"
  }
  module "dirent.h" {
    export *
    header "dirent.h"
  }
  module "pwd.h" {
    export *
    header "pwd.h"
  }
  module "grp.h" {
    export *
    header "grp.h"
  }
  module "sys_types.h" {
    export *
    header "sys/types.h"
  }
  module "sys_stat.h" {
    export *
    header "sys/stat.h"
  }
}
